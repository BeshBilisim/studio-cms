---
import { Generator } from 'studiocms:components';

interface Props {
	title?: string;
}

const { title = 'StudioCMS' } = Astro.props;
---

<!doctype html>
<html lang="tr">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<Generator />
		<title>{title}</title>
	</head>
	<body>
		<main>
			<slot />
		</main>
	</body>
</html>

<style>
	:global(*) {
		box-sizing: border-box;
	}

	:global(body) {
		margin: 0;
		font-family: system-ui, sans-serif;
	}

	main {
		width: min(72rem, calc(100% - 2rem));
		margin-inline: auto;
		padding-block: 3rem;
	}
</style>

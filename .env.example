# Coolify PostgreSQL service connection string.
DATABASE_URL=postgresql://emdash:change-me@postgres:5432/emdash

# Generate a unique value with: npx emdash secrets generate
EMDASH_ENCRYPTION_KEY=

# In Coolify, mount a persistent volume at this path.
EMDASH_UPLOADS_DIR=/app/uploads

# Public HTTPS URL after the Coolify domain is assigned.
EMDASH_SITE_URL=https://cms.example.com
